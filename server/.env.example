NODE_ENV=development

# ---------------- SERVICE PORTS ----------------
GATEWAY_PORT=5000
AUTH_PORT=5001
KYC_APP_PORT=5002
CUSTOMER_PORT=5003
DEVICE_PORT=5004
TRACKING_PORT=5005
MASTER_PORT=5006

# ---------------- SERVICE URLS (used by api-gateway) ----------------
AUTH_SERVICE=http://127.0.0.1:5001
KYC_APP_SERVICE=http://127.0.0.1:5002
CUSTOMER_SERVICE=http://127.0.0.1:5003
DEVICE_SERVICE=http://127.0.0.1:5004
TRACKING_SERVICE=http://127.0.0.1:5005
MASTER_SERVICE=http://127.0.0.1:5006

# Comma separated list of origins allowed to call the gateway
CLIENT_URLS=http://localhost:3000,http://127.0.0.1:3000

# ---------------- MYSQL ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=shreeji_app
SEQUELIZE_LOGGING=0

# ---------------- SECURITY ----------------
JWT_SECURITY_KEY=change_me
JWT_REFRESH_KEY=change_me
# 32 byte hex key used for AES-256-GCM encryption of sensitive fields (Aadhaar number etc.)
CRYPTO_SECURITY_KEY=change_me
ADMIN_ACCESS_TOKEN_EXPIRY=1h
CUSTOMER_ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY_DAYS=30

# ---------------- OTP ----------------
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
# 1 = return OTP in API response and print it in console (no SMS gateway). Set 0 in production.
OTP_DEV_MODE=1

# ---------------- FILE STORAGE ----------------
# Relative to the server folder
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---------------- DEVICE ----------------
# A device is considered offline if no heartbeat/location within these many minutes
DEVICE_OFFLINE_AFTER_MINUTES=15

# ---------------- SEED ADMIN (used by npm run db:init) ----------------
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@shreeji.com
SEED_ADMIN_PASSWORD=Admin@123
