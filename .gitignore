# ---------------------------------------------------------------------------
# Root .gitignore for the Shreeji admin monorepo (client + server).
# Sub-projects (client/, server/) also have their own .gitignore files;
# these global rules are a safety net so nothing sensitive or bulky slips in.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment & secrets (NEVER commit these)
.env
.env.*
!.env.example
**/.env
**/.env.local
**/.env.*.local

# Next.js / build output
.next/
**/.next/
out/
**/out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Uploaded files (KYC documents, selfies, etc.)
uploads/
**/uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Process managers / runtime
.pm2/
pids/
*.pid
*.seed

# Testing / coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.turbo/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
